# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# env (stdio / single-tenant HTTP) or gateway (x-freshdesk-domain and
# x-freshdesk-api-key on each /mcp request; no fallback to FRESHDESK_*).
# The container image and Compose default to gateway.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (changeme, your-s2s-secret, secret, placeholder, and similar
# public example values), so a copied example cannot forge X-Gateway-S2S.
# Compose will not start when it is unset or empty. Never commit a real
# secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A known placeholder secret is still rejected.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address for HTTP. When unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets
# 0.0.0.0. The insecure-dev bypass ignores it and binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# LOG_LEVEL=info
